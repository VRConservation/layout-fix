# -*- coding: utf-8 -*-"""layout_fix.pyt - layout cleanup tools for ArcGIS Pro."""import arcpyclass Toolbox(object):    def __init__(self):        self.label = "Layout Fix"        self.alias = "layout_fix"        self.tools = [FixLayout]class FixLayout(object):    def __init__(self):        self.label = "Fix Layout"        self.description = (            "Removes map frame borders and styles service layer credits."        )        self.canRunInBackground = False    def getParameterInfo(self):        layout = arcpy.Parameter(            displayName="Layout",            name="layout",            datatype="GPString",            parameterType="Optional",            direction="Input")        layout.filter.type = "ValueList"        layout.filter.list = []        size = arcpy.Parameter(            displayName="Credits Size (points)",            name="size",            datatype="GPDouble",            parameterType="Required",            direction="Input")        size.value = 6.0        gray = arcpy.Parameter(            displayName="Credits Gray (0-255)",            name="gray",            datatype="GPLong",            parameterType="Required",            direction="Input")        gray.value = 128        return [layout, size, gray]    def isLicensed(self):        return True    def updateParameters(self, parameters):        aprx = arcpy.mp.ArcGISProject("CURRENT")        parameters[0].filter.list = [lyt.name for lyt in aprx.listLayouts()]    def updateMessages(self, parameters):        pass    def execute(self, parameters, messages):        aprx = arcpy.mp.ArcGISProject("CURRENT")        name = parameters[0].valueAsText        size = float(parameters[1].value)        gray = int(parameters[2].value)        layouts = aprx.listLayouts()        if name:            layouts = [lyt for lyt in layouts if lyt.name == name]        if not layouts:            arcpy.AddWarning("No matching layouts found.")            return        for lyt in layouts:            border_removed = self._remove_borders(lyt)            credits_styled = self._style_credits(lyt, size, gray)            if border_removed:                arcpy.AddMessage("Removed map frame border(s) in '{}'.".format(lyt.name))            else:                arcpy.AddWarning("No map frame with a border found in '{}'.".format(lyt.name))            if credits_styled:                arcpy.AddMessage("Styled service layer credits in '{}'.".format(lyt.name))            else:                arcpy.AddWarning(                    "No service layer credits element found in '{}'.".format(lyt.name)                )        aprx.save()    @staticmethod    def _remove_borders(lyt):        lyt_cim = lyt.getDefinition("V3")        hit = False        for elm in lyt_cim.elements:            if type(elm).__name__ != "CIMMapFrame":                continue            border = elm.graphicFrame.borderSymbol            if border and border.symbol.symbolLayers:                for sym in border.symbol.symbolLayers:                    sym.width = 0                hit = True        if hit:            lyt.setDefinition(lyt_cim)        return hit    @staticmethod    def _style_credits(lyt, size, gray):        lyt_cim = lyt.getDefinition("V3")        hit = False        for elm in lyt_cim.elements:            g = getattr(elm, "graphic", None)            if g is None:                continue            text = getattr(g, "text", "") or ""            if "serviceLayerCredits" not in text:                continue            hit = True            tsym = g.symbol.symbol            tsym.height = size            glyph = getattr(tsym, "symbol", None)            for lyr in getattr(glyph, "symbolLayers", None) or []:                color = getattr(lyr, "color", None)                if color is not None and getattr(color, "values", None) is not None:                    color.values = [gray, gray, gray, 100]        if hit:            lyt.setDefinition(lyt_cim)        return hit